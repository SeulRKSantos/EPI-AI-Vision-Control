# Copy to .env and fill in. .env is never committed.
# Every service reads this file (env_file in docker-compose.yml).

# --- Database ---------------------------------------------------------------
POSTGRES_DB=epi_access
POSTGRES_USER=epi
POSTGRES_PASSWORD=change-me

# --- Backend ----------------------------------------------------------------
# The panel is opened from any machine on the network, so any origin is allowed.
CORS_ORIGINS=["*"]
# Seconds the backend waits for the vision result before denying.
SESSION_TIMEOUT_SECONDS=8
# Detections below this confidence count as absent (also colours the live view).
DETECTION_CONFIDENCE_THRESHOLD=0.6
# The same badge is ignored for this long after a scan.
BADGE_COOLDOWN_SECONDS=5

# --- Vision (Roboflow) ------------------------------------------------------
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW=
CAMERA_INDEX=0
# Must stay below SESSION_TIMEOUT_SECONDS.
INFERENCE_TIMEOUT_SECONDS=6
# Live boxes on the gate view: one inference every N seconds while someone
# watches. 0 turns the live view into plain video (boxes only on badge scans).
LIVE_INFERENCE_INTERVAL_SECONDS=1.5

# Do not set MQTT_CLIENT_ID here: backend and vision share this file and need
# different ids (docker-compose.yml sets the vision one).
