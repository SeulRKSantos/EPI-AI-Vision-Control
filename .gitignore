# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
 
# Treinamento YOLO (pesado, não versiona)
training/runs/
training/datasets/raw/*
training/datasets/annotated/*
training/weights/*.pt
training/weights/*.onnx
!training/datasets/raw/.gitkeep
!training/datasets/annotated/.gitkeep
!training/weights/.gitkeep
 
# Ambiente / segredos
.env
 
# Dados persistidos do container (postgres, mosquitto)
docker/data/
 
# Sistema
.DS_Store

# Pesos copiados pro container de vision em build/runtime
vision/models/*.pt
vision/models/*.onnx
!vision/models/.gitkeep
*.save

# Firmware build output and site credentials
firmware/**/.pio/
firmware/**/include/config.h
