# ---- Application ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=epi_access
POSTGRES_USER=epi
POSTGRES_PASSWORD=changeme
DB_ECHO=false

# ---- MQTT broker ----
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=epi-backend
MQTT_QOS=1

# ---- Access control policy ----
# Max wait for a vision result before denying access (seconds).
# Calibrate against measured inference latency in stage 7.
SESSION_TIMEOUT_SECONDS=8.0
# Detections below this confidence count as not detected.
DETECTION_CONFIDENCE_THRESHOLD=0.60
# Ignore repeated scans of the same badge within this window (seconds).
BADGE_COOLDOWN_SECONDS=5.0
